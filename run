#!/bin/zsh
# Збірка й запуск одного .cpp файлу.
#   ./run Lab/Lab-2/lab-2.cpp        -> build/lab-2/lab-2
#   ./run Lessons/lesson_8.cpp       -> build/les_8
#   ./run -b Lab/Lab-2/lab-2.cpp     -> лише зібрати, не запускати
set -e
cd "$(dirname "$0")"

run_after=1
if [[ "$1" == "-b" ]]; then run_after=0; shift; fi

src="$1"
if [[ -z "$src" || ! -f "$src" ]]; then
  echo "Використання: ./run [-b] шлях/до/файлу.cpp" >&2
  exit 1
fi

name="${src:t:r}"            # lab-2.cpp -> lab-2 (розширення відкидається завжди)
dir="${src:h:t:l}"           # Lab/Lab-2 -> lab-2

case "$dir" in
  lessons) out="build/${name/lesson_/les_}" ;;   # lesson_8 -> build/les_8
  *)       mkdir -p "build/$dir"; out="build/$dir/$name" ;;
esac

flags=(-std=c++23 -Wall -Wextra -Wpedantic -g -fsanitize=address,undefined)

# Два кроки (компіляція -> лінкування), щоб clang не створював теки *.dSYM.
clang++ "${flags[@]}" -c "$src" -o "$out.o"
clang++ -fsanitize=address,undefined "$out.o" -o "$out"
rm -f "$out.o"

echo "Зібрано: $out"
if (( run_after )); then
  echo "--------------------"
  exec "./$out"
fi
